# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# Google Gemini: image generation, hotspot segmentation and Veo morph clips.
GEMINI_API_KEY=
# Anthropic: Claude scores candidate images and verifies hotspots.
ANTHROPIC_API_KEY=
# OpenAI: only used by the image-provider bake-off.
OPENAI_API_KEY=
# Optional fal.ai key, only needed when DSP_SEGMENTATION_PROVIDER=sam3.
FAL_KEY=

# Image generator to use: gemini (default) or openai.
DSP_IMAGE_PROVIDER=
# Hotspot segmenter to use: gemini (default) or sam3.
DSP_SEGMENTATION_PROVIDER=
# Maximum estimated spend in US dollars per pipeline run (default 15).
DSP_MAX_SPEND_USD=
